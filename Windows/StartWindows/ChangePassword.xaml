<Window x:Class="EleonHotel.Windows.StartWindows.ChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.StartWindows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:classes="clr-namespace:EleonHotel.Data.Classes"
        xmlns:converters="clr-namespace:EleonHotel.Data.Converters"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Изменение пароля" Height="570" Width="560" MinWidth="560" MinHeight="570">
    <ScrollViewer Background="#22220398" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.Resources>
                <converters:BoolToPackIconKindConverter x:Key="BoolToPackIconKindConverter"/>
                <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            </Grid.Resources>
        
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="150" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label FontSize="14" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Italic.ttf#Roboto Condensed" Grid.Row="4" Grid.Column="0" Content="Логин" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox FontSize="14" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Italic.ttf#Roboto Condensed" x:Name="TbLogin" IsEnabled="False" Grid.Row="4" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>

            <Label FontSize="14" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Italic.ttf#Roboto Condensed" Grid.Row="6" Grid.ColumnSpan="2" Grid.Column="0" Content="Придумайте новый пароль" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="TbPassword" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint=""
                     materialDesign:TextFieldAssist.HasClearButton="True" 
                 Grid.Row="6" Grid.ColumnSpan="3" Grid.Column="2" 
                 HorizontalAlignment="Center" TextWrapping="NoWrap" 
                 VerticalAlignment="Center" Width="330"/>

        <!-- Оценка силы пароля -->
        <ProgressBar Value="{Binding StrengthPercent, Mode=OneWay}"
                         Background="{DynamicResource MaterialDesignDivider}"
                         Foreground="{Binding StrengthBrush}"
                         Grid.Column="2" Grid.ColumnSpan="3"  HorizontalAlignment="Center" Height="10" Grid.Row="7" VerticalAlignment="Center" Width="166"/>
        <TextBlock Text="{Binding StrengthText}" 
               Foreground="{Binding StrengthBrush}" 
               FontWeight="SemiBold" Grid.ColumnSpan="1" Grid.Column="3" HorizontalAlignment="Center" Grid.Row="7" TextWrapping="Wrap" VerticalAlignment="Top"/>


        <StackPanel Grid.ColumnSpan="3" Grid.RowSpan="5" Grid.Row="9" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- Длина -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding IsLongEnough, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding IsLongEnough, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Не менее 8 символов" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Заглавные -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding HasUpper, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding HasUpper, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Заглавная буква (A-Z, А-Я)" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Строчные -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding HasLower, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding HasLower, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Строчная буква (a-z, а-я)" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Цифры -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding HasDigit, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding HasDigit, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Цифра (0-9)" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Спецсимволы -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding HasSpecial, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding HasSpecial, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Спецсимвол" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

            <Label FontSize="16" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Italic.ttf#Roboto Condensed" Grid.Row="18" Grid.ColumnSpan="2" Grid.Column="0" Content="Подтвердите пароль" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <PasswordBox FontSize="16" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Italic.ttf#Roboto Condensed" x:Name="PbConfirmPassword" 
                     Grid.Row="18" Grid.ColumnSpan="4" Grid.Column="2" 
                     HorizontalAlignment="Left" 
                     VerticalAlignment="Center" Width="330"
                     materialDesign:HintAssist.Hint="Повторите пароль"/>

            <Button FontSize="16" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-BoldItalic.ttf#Roboto Condensed" x:Name="BtnChangePassword" Width="200" Height="40" Grid.Row="20" Grid.Column="2" Grid.RowSpan="5" Grid.ColumnSpan="2" Content="Изменить пароль" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnChangePassword_Click"/>
        </Grid>
    </ScrollViewer>
</Window>
