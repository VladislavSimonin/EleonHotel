<Window x:Class="EleonHotel.Windows.StartWindows.AccountRecovery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.StartWindows"
        xmlns:easy="clr-namespace:EasyCaptcha.Wpf;assembly=EasyCaptcha.Wpf"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Восстановление аккаунта" Height="850" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>

        </Grid.RowDefinitions>

        <Label FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed" FontSize="20" Grid.Row="1" Grid.Column="0" Content="Логин" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed" FontSize="20" x:Name="TbLogin" Grid.Column="1" Grid.ColumnSpan="3"  HorizontalAlignment="Left" Grid.Row="1" Text="" VerticalAlignment="Center" Width="400"/>

        <Label FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed" FontSize="20" Grid.Row="3" Grid.Column="0" Content="Email" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed" FontSize="20" x:Name="TbEmail" Grid.Column="1" Grid.ColumnSpan="3"  HorizontalAlignment="Left" Grid.Row="3" Text="" VerticalAlignment="Center" Width="400"/>

        <TextBlock FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed" FontSize="14" Grid.Row="5" TextWrapping="Wrap" Grid.Column="2" Grid.ColumnSpan="2" TextAlignment="Center" Text="Мы должны убедиться, что Вы не робот. Пожалуйста, введите символы, находящиеся ниже:" HorizontalAlignment="Center" VerticalAlignment="Center" Width="267"/>


        <StackPanel Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="7">
            <!-- Контрол капчи -->
            <easy:Captcha x:Name="MyCaptcha" Width="200" Height="160" Margin="10"/>

            <!-- Поле для ввода ответа пользователем -->
            <TextBox x:Name="AnswerTextBox" Width="200" Margin="10" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed" FontSize="20"/>

            <Button x:Name="CheckButton" Content="Проверить" Click="CheckButton_Click" Width="150" Height="34"/>
            <Button x:Name="RefreshButton" Content="Обновить" Click="RefreshButton_Click" Width="150" Height="34" Margin="5"/>
        </StackPanel>

        <Label FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed" FontSize="20" Grid.Row="13" Grid.Column="0" Content="Код" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed" FontSize="20" x:Name="TbCode" Grid.Column="1" Grid.ColumnSpan="2"  HorizontalAlignment="Left" Grid.Row="13" Text="" VerticalAlignment="Center" Width="70" MaxLength="6"/>

        <Button FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Medium.ttf#Roboto Condensed" FontSize="20" Grid.Column="2" Grid.Row="14" Grid.ColumnSpan="2" Grid.RowSpan="2" x:Name="BtnAccept" Content="Подтвердить" VerticalAlignment="Bottom" Click="BtnAccept_Click" Width="180" Height="44" Margin="5"/>
        
    </Grid>
</Window>
