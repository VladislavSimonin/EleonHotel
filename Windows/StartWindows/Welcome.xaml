<Window x:Class="EleonHotel.Windows.StartWindows.Welcome"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.StartWindows"
        mc:Ignorable="d"
        ResizeMode="CanResizeWithGrip"
        Title="Добро пожаловать" Height="540" Width="960" MinHeight="480" MinWidth="640">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            
            <Label FontSize="36" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Content="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Label FontSize="24" Grid.Row="1" Grid.Column="0" Content="Логин" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Label FontSize="24" Grid.Row="2" Grid.Column="0" Content="Пароль" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <TextBox Grid.Column="1" HorizontalAlignment="Center" Grid.Row="1" Text="" VerticalAlignment="Center" Width="156"/>
            <PasswordBox
    Grid.Column="1" HorizontalAlignment="Center" Grid.Row="2" VerticalAlignment="Center" Width="156"
    Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}"/>
            
            <Button x:Name="Enter" Grid.Column="2" Content="Войти" Grid.RowSpan="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="4" Width="198"/>
            <Button x:Name="ForgetPassword" Grid.Column="1" Content="Забыли пароль?" HorizontalAlignment="Center" Margin="0,24,0,0" Grid.Row="3" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
            <Button x:Name="CreateAccount" Grid.Column="1" Content="Создать аккаунт" HorizontalAlignment="Center" Margin="0,84,0,0" Grid.Row="3" VerticalAlignment="Top" Grid.ColumnSpan="2" Click="CreateAccount_Click"/>

        </Grid>
    </Grid>

</Window>
