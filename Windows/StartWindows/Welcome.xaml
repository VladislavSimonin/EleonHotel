<Window x:Class="EleonHotel.Windows.StartWindows.Welcome"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.StartWindows"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Добро пожаловать" MinHeight="540" MinWidth="790" MaxHeight="840" MaxWidth="1100">

    <Grid Background="#22220398">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock FontSize="36" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-BoldItalic.ttf#Roboto Condensed" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Text="Добро пожаловать в отель Элеон!" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" Width="460"/>
            <Label FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed" FontSize="24" Grid.Row="1" Grid.Column="0" Content="Логин" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Label FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed" FontSize="24" Grid.Row="2" Grid.Column="0" Content="Пароль" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBox FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed" FontSize="24" x:Name="TbLogin" Grid.ColumnSpan="2" Grid.Column="1"  HorizontalAlignment="Left" Grid.Row="1" Text="" VerticalAlignment="Center" Width="256"/>
            <PasswordBox x:Name="PbPassword" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed" FontSize="24"
    Grid.Column="1"  HorizontalAlignment="Left" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Width="256"
    Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}"/>

            <Button FontSize="20" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Medium.ttf#Roboto Condensed" x:Name="Enter" Grid.Column="1" Content="Войти" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="2" Width="198" Click="Enter_Click" Height="40"/>
            <Button FontSize="16" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Light.ttf#Roboto Condensed" x:Name="BtnCreateAccount" Grid.Column="2" Content="Создать аккаунт" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2" Click="CreateAccount_Click" Grid.RowSpan="2" Width="172" Height="32" Margin="115,131,0,0"/>
            <Button FontSize="12" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Light.ttf#Roboto Condensed" x:Name="BtnForgotAcc" Grid.Column="1" Grid.RowSpan="1" Content="Забыли пароль?" HorizontalAlignment="Center" Grid.Row="2" VerticalAlignment="Bottom" Width="140" Height="22" Click="BtnForgotAcc_Click" />

        </Grid>
    </Grid>

</Window>
