<Window x:Class="EleonHotel.Windows.StartWindows.CreateAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.StartWindows" 
        mc:Ignorable="d"
        xmlns:classes="clr-namespace:EleonHotel.Data.Classes"
        xmlns:converters="clr-namespace:EleonHotel.Data.Converters"
        ResizeMode="NoResize"
        Title="Создать аккаунт" Height="510" Width="560" MinWidth="660" MinHeight="430">
    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Visible" Height="450">
        <Grid>
            <Grid.Resources>
                <converters:BoolToPackIconKindConverter x:Key="BoolToPackIconKindConverter"/>
                <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            </Grid.Resources>
        
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
        <Label Grid.Row="1" Grid.Column="0" Content="Фамилия" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="2" Grid.Column="0" Content="Имя" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="3" Grid.Column="0" Content="Отчество" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="4" Grid.Column="0" Content="Ваш день рождения" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="5" Grid.Column="0" Content="Серия паспорта" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="6" Grid.Column="0" Content="Номер паспорта" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="7" Grid.Column="0" Content="Кем выдан паспорт" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="8" Grid.Column="0" Content="Дата выдачи паспорта" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="9" Grid.Column="0" Content="Адрес регистрации" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="10" Grid.Column="0" Content="Номер телефона" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="11" Grid.Column="0" Content="Электронная почта" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="12" Grid.Column="0" Content="Придумайте логин" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Row="13" Grid.Column="0" Content="Придумайте пароль" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <TextBox x:Name="TbSurname" MaxLength="30" Grid.Row="1" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <TextBox x:Name="TbName" MaxLength="30" Grid.Row="2" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <TextBox x:Name="TbPatronymic" MaxLength="30" Grid.Row="3" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <DatePicker x:Name="Birthsday" Grid.Column="2" Grid.Row="4"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="TbPassportSeries" MaxLength="4" Grid.Row="5" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <TextBox x:Name="TbPassportNumber" MaxLength="6" Grid.Row="6" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <TextBox x:Name="TbWhoGavePassport" MaxLength="100" Grid.Row="7" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <DatePicker x:Name="WhenPassportGave" Grid.Column="2" Grid.Row="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="TbRegistrationAddress" Grid.Row="9" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <TextBox x:Name="TbPhone" Grid.Row="10" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <TextBox x:Name="TbEmail" Grid.Row="11" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <TextBox x:Name="TbLogin" Grid.Row="12" Grid.ColumnSpan="3" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="NoWrap" Text="" VerticalAlignment="Center" Width="330"/>
        <TextBox x:Name="TbPassword" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint=""
                     materialDesign:TextFieldAssist.HasClearButton="True" 
                 Grid.Row="13" Grid.ColumnSpan="3" Grid.Column="1" 
                 HorizontalAlignment="Center" TextWrapping="NoWrap" 
                 VerticalAlignment="Center" Width="330"/>

        <!-- Оценка силы пароля -->
        <ProgressBar Value="{Binding StrengthPercent, Mode=OneWay}"
                         Background="{DynamicResource MaterialDesignDivider}"
                         Foreground="{Binding StrengthBrush}"
                         Grid.Column="1" Grid.ColumnSpan="3"  HorizontalAlignment="Center" Height="10" Grid.Row="14" VerticalAlignment="Center" Width="166"/>
        <TextBlock Text="{Binding StrengthText}" 
               Foreground="{Binding StrengthBrush}" 
               FontWeight="SemiBold" Grid.ColumnSpan="1" Grid.Column="2" HorizontalAlignment="Center" Grid.Row="15" TextWrapping="Wrap" VerticalAlignment="Top"/>


        <StackPanel Grid.ColumnSpan="3" Grid.RowSpan="5" Grid.Row="16" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- Длина -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding IsLongEnough, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding IsLongEnough, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Не менее 8 символов" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Заглавные -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding HasUpper, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding HasUpper, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Заглавная буква (A-Z, А-Я)" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Строчные -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding HasLower, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding HasLower, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Строчная буква (a-z, а-я)" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Цифры -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding HasDigit, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding HasDigit, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Цифра (0-9)" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Спецсимволы -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <materialDesign:PackIcon Kind="{Binding HasSpecial, Converter={StaticResource BoolToPackIconKindConverter}}"
                                         Foreground="{Binding HasSpecial, Converter={StaticResource BoolToColorConverter}}"
                                         Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Спецсимвол" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Label Content="Кто Вы?" HorizontalAlignment="Center" Grid.Row="23" VerticalAlignment="Center"/>


        <Button x:Name="BtnCreateAccount" Grid.Row="26" Grid.ColumnSpan="1" Grid.Column="2" Content="Создать аккаунт" HorizontalAlignment="Center" VerticalAlignment="Top" Click="BtnCreateAccount_Click" Grid.RowSpan="2"/>
        <RadioButton x:Name="RbGuest" Grid.Column="1" Content="Гость" HorizontalAlignment="Left" Grid.Row="23" VerticalAlignment="Center" />
        <RadioButton x:Name="RbEmployee" Grid.Column="1" Content="Сотрудник" HorizontalAlignment="Left" Grid.Row="24" VerticalAlignment="Center"/>
        </Grid>
    </ScrollViewer>
</Window>
