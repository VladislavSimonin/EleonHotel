<Window x:Class="EleonHotel.Windows.MainWindows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.MainWindows"
        mc:Ignorable="d"
        Title="Панель администратора" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Панель администратора" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                   ItemWidth="200" ItemHeight="50">
            <Button Content="Информация о пользователях" 
                    Click="BtnFullUsersInfo_Click"
                    Margin="10" Padding="15,10"/>
            
            <Button Content="Состояние номеров" 
                    Click="BtnRoomsCondition_Click"
                    Margin="10" Padding="15,10"/>
            
            <Button Content="Удаление пользователей" 
                    Click="BtnDeleteUser_Click"
                    Margin="10" Padding="15,10"/>
            
            <Button Content="Стоимость номеров" 
                    Click="BtnRoomsCost_Click"
                    Margin="10" Padding="15,10"/>
            
            <Button Content="Информация о сотрудниках" 
                    Click="BtnStaffInfo_Click"
                    Margin="10" Padding="15,10"/>
            
            <Button Content="Конфликты и штрафы" 
                    Click="BtnConflicts_Click"
                    Margin="10" Padding="15,10"/>
            
            <Button Content="Информация о гостях" 
                    Click="BtnGuestsInfo_Click"
                    Margin="10" Padding="15,10"/>
        </WrapPanel>
    </Grid>
</Window>
