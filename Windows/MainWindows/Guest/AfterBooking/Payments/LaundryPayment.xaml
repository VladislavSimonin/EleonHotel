<Window x:Class="EleonHotel.Windows.MainWindows.Guest.AfterBooking.Payments.LaundryPayment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.MainWindows.Guest.AfterBooking"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="Оплата прачечной" Height="550" Width="450">
    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FF2E69" Padding="20">
            <TextBlock Text="Оплата прачечной"
                       FontSize="24"
                       FontWeight="Bold"
                       FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основная информация -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <StackPanel>
                <!-- Информация об услуге -->
                <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Информация об услуге"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"
                                   Foreground="#FF2E69"
                                   Margin="0,0,0,10"/>

                        <StackPanel Margin="0,5">
                            <TextBlock Text="Название услуги:"
                                       FontSize="14"
                                       FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed"
                                       Foreground="#666666"/>
                            <TextBlock x:Name="TblServiceName"
                                       FontSize="16"
                                       FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"
                                       Margin="0,2,0,10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Информация об оплате -->
                <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Детали оплаты"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"
                                   Foreground="#FF2E69"
                                   Margin="0,0,0,10"/>

                        <StackPanel Margin="0,5">
                            <TextBlock Text="Стоимость услуги:"
                                       FontSize="14"
                                       FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed"
                                       Foreground="#666666"/>
                            <TextBlock x:Name="TblServiceCost"
                                       FontSize="16"
                                       FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"
                                       Margin="0,2,0,10"/>
                        </StackPanel>

                        <Separator Margin="0,10"/>

                        <StackPanel Margin="0,10">
                            <TextBlock Text="Итого к оплате:"
                                       FontSize="18"
                                       FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"
                                       Foreground="#333333"/>
                            <TextBlock x:Name="TblTotalAmount"
                                       FontSize="28"
                                       FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-ExtraBoldItalic.ttf#Roboto Condensed"
                                       Foreground="#FF2E69"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Форма оплаты -->
                <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Способ оплаты"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"
                                   Foreground="#FF2E69"
                                   Margin="0,0,0,10"/>

                        <!-- Номер карты -->
                        <TextBlock Text="Номер карты"
                                   FontSize="12"
                                   FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed"
                                   Foreground="#666666"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TbCardNumber"
                                 materialDesign:HintAssist.Hint="0000 0000 0000 0000"
                                 FontSize="16"
                                 MaxLength="19"
                                 Margin="0,0,0,15"
                                 TextChanged="TbCardNumber_TextChanged"/>

                        <!-- Срок действия и CVV -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Срок действия"
                                           FontSize="12"
                                           FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed"
                                           Foreground="#666666"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="TbExpiryDate"
                                         materialDesign:HintAssist.Hint="MM/YY"
                                         FontSize="16"
                                         MaxLength="5"
                                         TextChanged="TbExpiryDate_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CVV"
                                           FontSize="12"
                                           FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed"
                                           Foreground="#666666"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="TbCvv"
                                         materialDesign:HintAssist.Hint="123"
                                         FontSize="16"
                                         MaxLength="3"
                                         HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <!-- Имя держателя карты -->
                        <TextBlock Text="Имя держателя карты"
                                   FontSize="12"
                                   FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed"
                                   Foreground="#666666"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TbCardHolder"
                                 materialDesign:HintAssist.Hint="IVAN IVANOV"
                                 FontSize="16"
                                 Margin="0,0,0,15"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCancel"
                        Content="Отмена"
                        FontSize="16"
                        FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Medium.ttf#Roboto Condensed"
                        Background="#CCCCCC"
                        Foreground="#333333"
                        Padding="30,10"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click" Height="38" VerticalAlignment="Bottom"/>

                <Button x:Name="BtnPay"
                        Height="38"
                        Grid.Column="1"
                        Content="Оплатить"
                        FontSize="16"
                        FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"
                        Background="#FF2E69"
                        Foreground="White"
                        Padding="40,10"
                        Click="BtnPay_Click"/>
            </Grid>
        </Border>

        <!-- Индикатор загрузки -->
        <Border x:Name="LoadingOverlay"
                Grid.RowSpan="3"
                Background="#80000000"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Width="60"
                            Height="60"
                            Foreground="White"
                            Value="0"
             IsIndeterminate="True" />
                <TextBlock Text="Обработка платежа..."
                           FontSize="18"
                           Foreground="White"
                           FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Medium.ttf#Roboto Condensed"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>