<Window x:Class="EleonHotel.Windows.MainWindows.Guest.BookedGuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.MainWindows.Guest"
        mc:Ignorable="d"
        Title="BookedGuestWindow" Height="450" Width="800">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Button x:Name="aboutMe" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Height="87" Width="154" Click="aboutMe_Click">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="Посмотреть информацию обо мне"/>
            </Button>

            <Button x:Name="orderDish" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Height="87" Width="154" Click="orderDish_Click">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="Заказать еду в номер"/>
            </Button>

            <Button x:Name="orderLaundry" Grid.Column="4" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Height="87" Width="154" Click="orderLaundry_Click">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="Заказать услуги прачечной"/>
            </Button>

            <Button x:Name="orderCleaning" Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Height="87" Width="154" Click="orderCleaning_Click">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="Заказать дополнительную уборку"/>
            </Button>

            <Button x:Name="orderTransfer" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Height="87" Width="154" Click="orderTransfer_Click">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="Заказать трансфер"/>
            </Button>

            <Button x:Name="inviteDoctor" Grid.Column="4" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Height="87" Width="154" Click="inviteDoctor_Click">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="Врач в номер"/>
            </Button>
        </Grid>
        
    </Grid>
</Window>
