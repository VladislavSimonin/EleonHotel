<Window x:Class="EleonHotel.Windows.MainWindows.Guest.AfterBooking.aboutMe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.MainWindows.Guest.AfterBooking"
        mc:Ignorable="d"
        Title="Обо мне" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Информация о моем размещении" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <!-- Номер комнаты -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Номер комнаты: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="RoomNumberText" Text="" FontSize="16" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Категория номера -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Категория номера: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="RoomCategoryText" Text="" FontSize="16" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Описание категории -->
        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="Описание: " FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="RoomDescriptionText" Text="" FontSize="14" TextWrapping="Wrap" Margin="10,0,0,0"/>
        </StackPanel>
        
        <!-- Дополнительные услуги -->
        <StackPanel Grid.Row="4" Margin="0,10,0,5">
            <TextBlock Text="Дополнительные услуги:" FontSize="16" FontWeight="Bold"/>
            <DataGrid x:Name="ServicesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" 
                      IsReadOnly="True" Height="150" Margin="0,5,0,0" 
                      HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="*"/>
                    <DataGridTextColumn Header="Количество заказов" Binding="{Binding OrderCount}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        
        <!-- Итоговый счет -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
            <TextBlock Text="Итоговый счет: " FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TotalAmountText" Text="" FontSize="18" FontWeight="Bold" Foreground="DarkGreen" VerticalAlignment="Center"/>
        </StackPanel>
        
    </Grid>
</Window>
