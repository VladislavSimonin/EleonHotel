                <Image Source="/Data/Images/Standart_1.jpg" Height="210" Width="270" Stretch="UniformToFill"/>
            </Button>

            <TextBlock FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed" FontSize="18" x:Name="TblStandartDesc" Grid.Column="3" Grid.ColumnSpan="3" 
                   HorizontalAlignment="Left" Grid.Row="12" TextWrapping="Wrap" 
                   VerticalAlignment="Top" Margin="10,10,0,0" MaxWidth="400"/>

            <Label Grid.Column="3" Grid.ColumnSpan="2" Content="Вместимость: 2 гостя" FontSize="18" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-BoldItalic.ttf#Roboto Condensed" 
