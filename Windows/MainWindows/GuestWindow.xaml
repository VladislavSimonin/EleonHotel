                Grid.Column="6" Grid.ColumnSpan="2" Width="250" Height="40" Grid.Row="21" Margin="10,10,0,0" Click="BtnComfortBooking_Click"/>
            <TextBlock x:Name="TbComfortBlock" Grid.Column="6" Grid.Row="22" Visibility="Collapsed" HorizontalAlignment="Left" Grid.ColumnSpan="2" TextWrapping="Wrap" Text="Превышена максимальная вместимость номера!" VerticalAlignment="Top" Foreground="#FF2E69" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Medium.ttf#Roboto Condensed" FontSize="16" TextAlignment="Center" Margin="10,0,0,0" Width="250"/>

