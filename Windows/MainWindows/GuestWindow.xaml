            <Label Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="4" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-BoldItalic.ttf#Roboto Condensed"
               FontSize="24" Content="Пожалуйста, выберите номер" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <Label Grid.Column="1" Grid.ColumnSpan="2" Content="Количество гостей:" FontSize="18" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed" 
   HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ComboBox x:Name="CbGuests" SelectionChanged="CbGuests_SelectionChanged" Grid.Column="2" HorizontalAlignment="Right" Grid.Row="1" Width="120"/>

            <TextBlock Grid.Column="3" HorizontalAlignment="Right" Grid.Row="1" TextWrapping="Wrap" Text="Дата въезда:" VerticalAlignment="Center" FontSize="18" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"/>
            <DatePicker x:Name="DtEnter" Grid.Column="4" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" DisplayDateStart="{x:Static sys:DateTime.Now}" IsEnabled="True" FontSize="18" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"/>
            <TextBlock Grid.Column="5" HorizontalAlignment="Right" Grid.Row="1" TextWrapping="Wrap" Text="Дата выезда:" VerticalAlignment="Center" FontSize="18" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"/>
            <DatePicker x:Name="DtOut" Grid.Column="6" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" DisplayDateStart="{x:Static sys:DateTime.Now}" IsEnabled="True" FontSize="18" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Bold.ttf#Roboto Condensed"/>


            <!-- Эконом -->
            <Label Grid.Column="0" Grid.ColumnSpan="6" Content="Эконом" FontSize="20" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-BoldItalic.ttf#Roboto Condensed" 
               HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Center" Margin="10,5"/>

            <Button x:Name="BtnEconomImage" Grid.Column="1" Grid.Row="3" Grid.RowSpan="5"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Click="BtnEconomImage_Click"
                Cursor="Hand" ToolTip="Нажмите для просмотра галереи" Height="229" Width="287" Grid.ColumnSpan="2" Margin="10,10,0,0">
                <Image Source="/Data/Images/Econom_1.jpg" Height="210" Width="270" Stretch="UniformToFill"/>
            </Button>

            <TextBlock FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-SemiBold.ttf#Roboto Condensed" FontSize="18" x:Name="TblEconomDesc" Grid.Column="3" Grid.ColumnSpan="3" 
                   HorizontalAlignment="Left" Grid.Row="4" TextWrapping="Wrap" 
                   VerticalAlignment="Top" Margin="10,5,0,0" MaxWidth="400"/>

            <Label Grid.Column="3" Grid.ColumnSpan="2" Content="Вместимость: 2 гостя" FontSize="18" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-BoldItalic.ttf#Roboto Condensed" 
            HorizontalAlignment="Left" Grid.Row="5" VerticalAlignment="Top" Margin="10,5,0,0"/>


            <Label Grid.Column="3" Content="Удобства:" FontSize="18" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-BoldItalic.ttf#Roboto Condensed" 
               HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Top" Margin="10,5,0,0"/>
            <TextBlock FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-BoldItalic.ttf#Roboto Condensed" FontSize="18" x:Name="TblEconomFacilities" Grid.Column="4" Grid.ColumnSpan="1" 
                   HorizontalAlignment="Left" Grid.Row="6" TextWrapping="Wrap" Margin="10,9,0,0" 
                   VerticalAlignment="Top"/>

            <Label Grid.Column="3" Content="Цена за сутки:" FontSize="18" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-BoldItalic.ttf#Roboto Condensed" 
               HorizontalAlignment="Left" Grid.Row="9" VerticalAlignment="Center" Margin="10,5,0,0"/>
            <TextBlock FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-ExtraBoldItalic.ttf#Roboto Condensed" FontSize="24" x:Name="TblEconomCost" Grid.Column="4" 
                   HorizontalAlignment="Left" Grid.Row="9" TextWrapping="Wrap" 
                   VerticalAlignment="Center" Margin="60,5,0,0"/>

            <Button FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Medium.ttf#Roboto Condensed" FontSize="24" x:Name="BtnEconomBooking" Content="Забронировать" 
                HorizontalAlignment="Left"  VerticalAlignment="Center" Grid.Row="5"
                Grid.Column="6" Grid.ColumnSpan="2" Width="250" Height="40" Margin="10,10,0,0" Click="BtnEconomBooking_Click"/>
            <TextBlock x:Name="TbEconomBlock" Grid.Column="6" Grid.Row="6" Visibility="Collapsed" HorizontalAlignment="Left" Grid.ColumnSpan="2" TextWrapping="Wrap" Text="Превышена максимальная вместимость номера!" VerticalAlignment="Top" Foreground="#FF2E69" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Medium.ttf#Roboto Condensed" FontSize="16" TextAlignment="Center" Margin="10,0,0,0" Width="250"/>

            <!-- Стандарт -->
