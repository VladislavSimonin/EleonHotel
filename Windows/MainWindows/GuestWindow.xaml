<Window x:Class="EleonHotel.Windows.MainWindows.GuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.MainWindows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        ResizeMode="CanResizeWithGrip"
        Title="Выбор номера" Height="940" Width="960" MinHeight="480" MinWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="1" Grid.RowSpan="4" Grid.Column="1" Grid.ColumnSpan="4" FontFamily="/Resources/Roboto/RobotoCondensed-BoldItalic.ttf#Roboto Condensed"
               FontSize="24" Content="Пожалуйста, выберите номер" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Эконом -->
        <Button x:Name="BtnEconomImage" Grid.Column="1" Margin="0,0,0,10" Grid.RowSpan="9" Grid.Row="8" 
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Click="BtnEconomImage_Click"
                Cursor="Hand" ToolTip="Нажмите для просмотра галереи" Height="229" Width="287" Grid.ColumnSpan="2" >
            <Image Source="/Data/Images/Econom_1.jpg" Height="210" Width="270" Stretch="UniformToFill"/>
        </Button>

        <Label Grid.Column="1" Grid.ColumnSpan="2" Content="Количество гостей" FontSize="18" FontFamily="/Resources/Roboto/RobotoCondensed-BoldItalic.ttf#Roboto Condensed" HorizontalAlignment="Left" Grid.Row="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="CbGuests" Grid.Column="2" HorizontalAlignment="Center" Grid.Row="5" Width="120"/>
        <TextBlock FontSize="14" x:Name="TblEconomDesc" Grid.RowSpan="3" Grid.Column="3" HorizontalAlignment="Left" Grid.Row="9" TextWrapping="Wrap" Text="{Binding description}" VerticalAlignment="Center"/>
        <TextBlock FontSize="14" x:Name="TblEconomFacilities" Grid.Column="3" HorizontalAlignment="left" Grid.Row="13" TextWrapping="Wrap" Text="{Binding facilities}" VerticalAlignment="center"/>
        <TextBlock FontSize="14" x:Name="TblEconomCost" Grid.Column="3" HorizontalAlignment="Center" Grid.Row="15" TextWrapping="Wrap" Text="{Binding cost}" VerticalAlignment="Center"/>
        <Label FontSize="14" Grid.Column="3" Content="Удобства:" HorizontalAlignment="Left" Grid.Row="12" VerticalAlignment="Center" />
        <Label FontSize="14" Grid.Column="3" Content="Цена:" HorizontalAlignment="Left" Grid.Row="15" VerticalAlignment="Center"/>
        <Button x:Name="BtnEconomBooking" Grid.Column="1" Grid.ColumnSpan="2" Content="Забронировать" HorizontalAlignment="Center" Grid.RowSpan="2" Grid.Row="17" VerticalAlignment="Center"/>

        <!-- Стандарт -->
        <Button x:Name="BtnStandartImage" Grid.Column="1" Margin="0,0,0,10" Grid.RowSpan="9" Grid.Row="8" 
        HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Click="BtnEconomImage_Click"
        Cursor="Hand" ToolTip="Нажмите для просмотра галереи" Height="229" Width="287" Grid.ColumnSpan="2" >
            <Image Source="/Data/Images/Standart_1.jpg" Height="210" Width="270" Stretch="UniformToFill"/>
        </Button>

        <TextBlock FontSize="14" x:Name="TblStandartDesc" Grid.RowSpan="3" Grid.Column="3" HorizontalAlignment="Left" Grid.Row="9" TextWrapping="Wrap" Text="{Binding description}" VerticalAlignment="Center"/>
        <TextBlock FontSize="14" x:Name="TblStandartFacilities" Grid.Column="3" HorizontalAlignment="left" Grid.Row="13" TextWrapping="Wrap" Text="{Binding facilities}" VerticalAlignment="center"/>
        <TextBlock FontSize="14" x:Name="TblStandartCost" Grid.Column="3" HorizontalAlignment="Center" Grid.Row="15" TextWrapping="Wrap" Text="{Binding cost}" VerticalAlignment="Center"/>
        <Label FontSize="14" Grid.Column="3" Content="Удобства:" HorizontalAlignment="Left" Grid.Row="12" VerticalAlignment="Center" />
        <Label FontSize="14" Grid.Column="3" Content="Цена:" HorizontalAlignment="Left" Grid.Row="15" VerticalAlignment="Center"/>
        <Button x:Name="BtnStandartBooking" Grid.Column="1" Grid.ColumnSpan="2" Content="Забронировать" HorizontalAlignment="Center" Grid.RowSpan="2" Grid.Row="17" VerticalAlignment="Center"/>

        <!-- Комфорт -->
        <Button x:Name="BtnComfortImage" Grid.Column="1" Margin="0,0,0,10" Grid.RowSpan="9" Grid.Row="8" 
        HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Click="BtnComfortImage_Click"
        Cursor="Hand" ToolTip="Нажмите для просмотра галереи" Height="229" Width="287" Grid.ColumnSpan="2" >
            <Image Source="/Data/Images/Comfort_1.jpg" Height="210" Width="270" Stretch="UniformToFill"/>
        </Button>

        <TextBlock FontSize="14" x:Name="TblComfortDesc" Grid.RowSpan="3" Grid.Column="3" HorizontalAlignment="Left" Grid.Row="9" TextWrapping="Wrap" Text="{Binding description}" VerticalAlignment="Center"/>
        <TextBlock FontSize="14" x:Name="TblComfortFacilities" Grid.Column="3" HorizontalAlignment="left" Grid.Row="13" TextWrapping="Wrap" Text="{Binding facilities}" VerticalAlignment="center"/>
        <TextBlock FontSize="14" x:Name="TblComfortCost" Grid.Column="3" HorizontalAlignment="Center" Grid.Row="15" TextWrapping="Wrap" Text="{Binding cost}" VerticalAlignment="Center"/>
        <Label FontSize="14" Grid.Column="3" Content="Удобства:" HorizontalAlignment="Left" Grid.Row="12" VerticalAlignment="Center" />
        <Label FontSize="14" Grid.Column="3" Content="Цена:" HorizontalAlignment="Left" Grid.Row="15" VerticalAlignment="Center"/>
        <Button x:Name="BtnComfortBooking" Grid.Column="1" Grid.ColumnSpan="2" Content="Забронировать" HorizontalAlignment="Center" Grid.RowSpan="2" Grid.Row="17" VerticalAlignment="Center"/>

        <!-- Семейный -->
        <Button x:Name="BtnFamilyImage" Grid.Column="1" Margin="0,0,0,10" Grid.RowSpan="9" Grid.Row="8" 
        HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Click="BtnFamilyImage_Click"
        Cursor="Hand" ToolTip="Нажмите для просмотра галереи" Height="229" Width="287" Grid.ColumnSpan="2" >
            <Image Source="/Data/Images/Family_1.jpg" Height="210" Width="270" Stretch="UniformToFill"/>
        </Button>

        <TextBlock FontSize="14" x:Name="TblFamilyDesc" Grid.RowSpan="3" Grid.Column="3" HorizontalAlignment="Left" Grid.Row="9" TextWrapping="Wrap" Text="{Binding description}" VerticalAlignment="Center"/>
        <TextBlock FontSize="14" x:Name="TblFamilyFacilities" Grid.Column="3" HorizontalAlignment="left" Grid.Row="13" TextWrapping="Wrap" Text="{Binding facilities}" VerticalAlignment="center"/>
        <TextBlock FontSize="14" x:Name="TblFamilyCost" Grid.Column="3" HorizontalAlignment="Center" Grid.Row="15" TextWrapping="Wrap" Text="{Binding cost}" VerticalAlignment="Center"/>
        <Label FontSize="14" Grid.Column="3" Content="Удобства:" HorizontalAlignment="Left" Grid.Row="12" VerticalAlignment="Center" />
        <Label FontSize="14" Grid.Column="3" Content="Цена:" HorizontalAlignment="Left" Grid.Row="15" VerticalAlignment="Center"/>
        <Button x:Name="BtnFamilyBooking" Grid.Column="1" Grid.ColumnSpan="2" Content="Забронировать" HorizontalAlignment="Center" Grid.RowSpan="2" Grid.Row="17" VerticalAlignment="Center"/>

        <!-- Бизнес -->
        <Button x:Name="BtnBusinessImage" Grid.Column="1" Margin="0,0,0,10" Grid.RowSpan="9" Grid.Row="8" 
        HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Click="BtnBusinessImage_Click"
        Cursor="Hand" ToolTip="Нажмите для просмотра галереи" Height="229" Width="287" Grid.ColumnSpan="2" >
            <Image Source="/Data/Images/Business_1.jpg" Height="210" Width="270" Stretch="UniformToFill"/>
        </Button>

        <TextBlock FontSize="14" x:Name="TblBusinessDesc" Grid.RowSpan="3" Grid.Column="3" HorizontalAlignment="Left" Grid.Row="9" TextWrapping="Wrap" Text="{Binding description}" VerticalAlignment="Center"/>
        <TextBlock FontSize="14" x:Name="TblBusinessFacilities" Grid.Column="3" HorizontalAlignment="left" Grid.Row="13" TextWrapping="Wrap" Text="{Binding facilities}" VerticalAlignment="center"/>
        <TextBlock FontSize="14" x:Name="TblBusinessCost" Grid.Column="3" HorizontalAlignment="Center" Grid.Row="15" TextWrapping="Wrap" Text="{Binding cost}" VerticalAlignment="Center"/>
        <Label FontSize="14" Grid.Column="3" Content="Удобства:" HorizontalAlignment="Left" Grid.Row="12" VerticalAlignment="Center" />
        <Label FontSize="14" Grid.Column="3" Content="Цена:" HorizontalAlignment="Left" Grid.Row="15" VerticalAlignment="Center"/>
        <Button x:Name="BtnBusinessBooking" Grid.Column="1" Grid.ColumnSpan="2" Content="Забронировать" HorizontalAlignment="Center" Grid.RowSpan="2" Grid.Row="17" VerticalAlignment="Center"/>

        <!-- Люкс -->
        <Button x:Name="BtnLuxImage" Grid.Column="1" Margin="0,0,0,10" Grid.RowSpan="9" Grid.Row="8" 
        HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Click="BtnLuxImage_Click"
        Cursor="Hand" ToolTip="Нажмите для просмотра галереи" Height="229" Width="287" Grid.ColumnSpan="2" >
            <Image Source="/Data/Images/Lux_1.jpg" Height="210" Width="270" Stretch="UniformToFill"/>
        </Button>

        <TextBlock FontSize="14" x:Name="TblLuxDesc" Grid.RowSpan="3" Grid.Column="3" HorizontalAlignment="Left" Grid.Row="9" TextWrapping="Wrap" Text="{Binding description}" VerticalAlignment="Center"/>
        <TextBlock FontSize="14" x:Name="TblLuxFacilities" Grid.Column="3" HorizontalAlignment="left" Grid.Row="13" TextWrapping="Wrap" Text="{Binding facilities}" VerticalAlignment="center"/>
        <TextBlock FontSize="14" x:Name="TblLuxCost" Grid.Column="3" HorizontalAlignment="Center" Grid.Row="15" TextWrapping="Wrap" Text="{Binding cost}" VerticalAlignment="Center"/>
        <Label FontSize="14" Grid.Column="3" Content="Удобства:" HorizontalAlignment="Left" Grid.Row="12" VerticalAlignment="Center" />
        <Label FontSize="14" Grid.Column="3" Content="Цена:" HorizontalAlignment="Left" Grid.Row="15" VerticalAlignment="Center"/>
        <Button x:Name="BtnLuxBooking" Grid.Column="1" Grid.ColumnSpan="2" Content="Забронировать" HorizontalAlignment="Center" Grid.RowSpan="2" Grid.Row="17" VerticalAlignment="Center"/>




    </Grid>
</Window>
