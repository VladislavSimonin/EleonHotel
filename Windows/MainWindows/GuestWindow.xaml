            <TextBlock x:Name="TbStandartBlock" Grid.Column="6" Grid.Row="14" Visibility="Collapsed" HorizontalAlignment="Left" Grid.ColumnSpan="2" TextWrapping="Wrap" Text="Превышена максимальная вместимость номера!" VerticalAlignment="Top" Foreground="#FF2E69" FontFamily="/Resources/Roboto_Condensed/static/RobotoCondensed-Medium.ttf#Roboto Condensed" FontSize="16" TextAlignment="Center" Margin="10,0,0,0" Width="250"/>

