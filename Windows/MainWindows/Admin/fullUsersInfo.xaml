<Window x:Class="EleonHotel.Windows.MainWindows.Admin.fullUsersInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.MainWindows.Admin"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Информация о пользователях" MinHeight="450" MinWidth="800">
    <Grid>
        <ScrollViewer Background="#22220398" CanContentScroll="True" VerticalScrollBarVisibility="Auto" >
            <DataGrid Name="UsersDataGrid" d:ItemsSource="{Binding}"/>
        </ScrollViewer>
    </Grid>
</Window>
