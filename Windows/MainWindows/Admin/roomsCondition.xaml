<Window x:Class="EleonHotel.Windows.MainWindows.Admin.roomsCondition"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EleonHotel.Windows.MainWindows.Admin"
        mc:Ignorable="d"
        Title="Управление комнатами" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление состоянием комнат" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" Name="RoomsDataGrid" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="False"
                  SelectionChanged="RoomsDataGrid_SelectionChanged"
                  RowEditEnding="RoomsDataGrid_RowEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID комнаты" Binding="{Binding room_id}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding room_category_name}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Вместимость" Binding="{Binding max_occupancy}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding cost, StringFormat={}{0:F2}}" Width="80"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding description}" Width="150"/>
                <DataGridComboBoxColumn Header="Статус" SelectedItemBinding="{Binding room_status_name}" Width="120"/>
                <DataGridTextColumn Header="Удобства" Binding="{Binding room_facility_name}" IsReadOnly="True" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Обновить" Click="RefreshButton_Click" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Click="CloseButton_Click" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>
